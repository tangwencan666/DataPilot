# Backend
APP_NAME=DataPilot API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=20
PREVIEW_ROW_LIMIT=20
PROFILE_MAX_ROWS=100000
PROFILE_SAMPLE_ROWS=50000
PROFILE_SAMPLE_VALUES=5
PROFILE_TOP_VALUES=10
PROFILE_MAX_CORRELATION_COLUMNS=20
PROFILE_MAX_CORRELATIONS=50
PROFILE_CORRELATION_THRESHOLD=0.5
QUALITY_HIGH_MISSING_THRESHOLD=0.3
QUALITY_HIGH_DUPLICATE_THRESHOLD=0.1
PROFILE_HIGH_CARDINALITY_MIN=50
PROFILE_HIGH_CARDINALITY_RATIO=0.8
UPLOAD_DIR=data/uploads
ALLOWED_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5432/datapilot
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
QUERY_TIMEOUT_SECONDS=10
QUERY_MAX_RESULT_CELLS=100000
QUERY_MAX_SQL_LENGTH=10000
MAX_QUESTION_LENGTH=2000
ANALYSIS_MAX_ROWS=200000
ANALYSIS_SAMPLE_ROWS=50000
ANALYSIS_MAX_RESULT_ROWS=1000
ANALYSIS_MAX_RESULT_CELLS=100000
ANALYSIS_MAX_OPERATIONS=10
ANALYSIS_MAX_COLUMNS=50
ANALYSIS_MAX_GROUPBY_COLUMNS=3
ANALYSIS_MAX_METRICS=10
ANALYSIS_MAX_SORT_COLUMNS=3
ANALYSIS_TIMEOUT_SECONDS=15
ANALYSIS_MAX_TOP_VALUES=100

# Frontend (copied to frontend/.env when needed)
VITE_API_BASE_URL=http://localhost:8000/api/v1
