# Backend
APP_NAME=DataPilot API
APP_ENV=development
DEBUG=false
AUTH_REQUIRED=true
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=20
PREVIEW_ROW_LIMIT=20
PROFILE_MAX_ROWS=100000
PROFILE_SAMPLE_ROWS=50000
PROFILE_SAMPLE_VALUES=5
PROFILE_TOP_VALUES=10
PROFILE_MAX_CORRELATION_COLUMNS=20
PROFILE_MAX_CORRELATIONS=50
PROFILE_CORRELATION_THRESHOLD=0.5
QUALITY_HIGH_MISSING_THRESHOLD=0.3
QUALITY_HIGH_DUPLICATE_THRESHOLD=0.1
PROFILE_HIGH_CARDINALITY_MIN=50
PROFILE_HIGH_CARDINALITY_RATIO=0.8
UPLOAD_DIR=data/uploads
ALLOWED_ORIGINS=http://localhost:5173
MAX_DATASETS_PER_USER=100
MAX_STORAGE_BYTES_PER_USER=1073741824
MAX_PAGE_SIZE=100
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_EXPENSIVE=20/minute
DATABASE_URL=postgresql+psycopg://datapilot:datapilot@localhost:5432/datapilot
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
QUERY_DEFAULT_LIMIT=100
QUERY_MAX_LIMIT=1000
QUERY_TIMEOUT_SECONDS=10
QUERY_MAX_RESULT_CELLS=100000
QUERY_MAX_SQL_LENGTH=10000
MAX_QUESTION_LENGTH=2000
ANALYSIS_MAX_ROWS=200000
ANALYSIS_SAMPLE_ROWS=50000
ANALYSIS_MAX_RESULT_ROWS=1000
ANALYSIS_MAX_RESULT_CELLS=100000
ANALYSIS_MAX_OPERATIONS=10
ANALYSIS_MAX_COLUMNS=50
ANALYSIS_MAX_GROUPBY_COLUMNS=3
ANALYSIS_MAX_METRICS=10
ANALYSIS_MAX_SORT_COLUMNS=3
ANALYSIS_TIMEOUT_SECONDS=15
ANALYSIS_MAX_TOP_VALUES=100
CHART_MAX_POINTS=5000
CHART_MAX_SERIES=20
CHART_MAX_CATEGORIES=100
CHART_MAX_PIE_SLICES=12
CHART_MAX_HISTOGRAM_BINS=100
CHART_MAX_TITLE_LENGTH=200
CHART_MAX_OPTION_BYTES=1000000
CHART_MAX_RESULT_ROWS=5000
AGENT_MAX_STEPS=8
AGENT_MAX_CONTEXT_COLUMNS=100
AGENT_MAX_SAMPLE_VALUES=3
AGENT_MAX_QUALITY_ISSUES=20
AGENT_MAX_CORRELATIONS=20
AGENT_MAX_CONTEXT_CHARS=30000
AGENT_MAX_INTERMEDIATE_ROWS=100
AGENT_MAX_INTERMEDIATE_CELLS=5000
AGENT_MAX_FINAL_FINDINGS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_REPAIRS_PER_STEP=1
AGENT_MAX_REPAIRS_PER_RUN=3
AGENT_REPAIR_TIMEOUT_SECONDS=15
AGENT_REPAIR_CONTEXT_CHARS=10000
AGENT_MAX_OBSERVATION_CHARS=4000
REPORT_MAX_INSIGHTS=10
REPORT_MAX_STEP_EVIDENCE=20
REPORT_MAX_EVIDENCE_ROWS_PER_STEP=10
REPORT_MAX_EVIDENCE_CHARS=50000
REPORT_MAX_PROFILE_ISSUES=20
REPORT_MAX_CORRELATIONS=20
REPORT_MAX_ARTIFACTS=20
REPORT_MAX_TITLE_LENGTH=200
REPORT_MAX_EXPORT_BYTES=1000000

# Frontend (copied to frontend/.env when needed)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Docker Compose PostgreSQL (development values only; replace for deployment)
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot-local-only
